{
  "opencollection": "1.0.0",
  "info": {
    "name": "get.typo3.org Cache API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Cache",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Purge caches related to TYPO3 major version.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/cache/majorVersion/:version",
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Purge caches related to TYPO3 major version."
        },
        {
          "info": {
            "name": "Purge caches related to single TYPO3 release.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/v1/cache/release/:version",
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Purge caches related to single TYPO3 release."
        }
      ]
    }
  ],
  "bundled": true
}